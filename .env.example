# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL Database Connection String (with pgvector extension)
# Example: postgres://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=your_neon_postgresql_connection_string_here

# Backend Server Port
PORT=3001
